# Local development settings for docker-compose.yml. No real secrets here.
# go run ./cmd/server -env-file dev.env
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://app:app@127.0.0.1:55433/app?sslmode=disable

# Tests create and drop their own databases on this server.
TEST_DATABASE_URL=postgres://app:app@127.0.0.1:55433/app?sslmode=disable

# Local MinIO standing in for Cloudflare R2.
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin-secret
R2_BUCKET=submissions
