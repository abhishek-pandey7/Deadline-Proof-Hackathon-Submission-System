# Production settings. Copy to .env (gitignored) and fill in; never commit real values.
APP_ENV=production

# Neon, direct connection (not the -pooler host): LISTEN/NOTIFY needs it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2, token scoped to one bucket with Object Read & Write.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deadline-crush-submissions
